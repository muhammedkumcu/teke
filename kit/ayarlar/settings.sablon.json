{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/teke/kancalar/oturum-baslangici.js"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/teke/kancalar/istem.js"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/teke/kancalar/ajan-kapisi.js"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "SendMessage|mcp__ccd_session_mgmt__send_message|mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/teke/kancalar/devir-kapisi.js"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/teke/kancalar/komut-kapisi.js"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/teke/kancalar/baglam-izle.js"
            ],
            "timeout": 10
          }
        ],
        "matcher": "Bash|PowerShell|Write|Agent|Task|Workflow|Skill"
      }
    ]
  }
}
