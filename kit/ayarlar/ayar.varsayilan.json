  "ajan": {
    "yasakModeller": [],
    "forkYasak": true,
    "modelZorunlu": true
  },
  "baglam": {
    "bildirYuzde": 50,
    "compactYuzde": 65,
    "pencere": 1000000,
    "pencereler": {}
  },
  "commit": {
    "ortakYazarYasak": false
  },
  "onay": {
    "desenler": [
      {
        "ad": "uzak depoya gönderme (git push)",
        "desen": "\\bgit(\\.exe)?(\\s+(-[cC]\\s+\\S+|--[\\w-]+(=\\S+)?))*\\s+push\\b"
      },
      {
        "ad": "yayın (deploy)",
        "desen": "\\b(wrangler|vercel|netlify|firebase|flyctl|fly)(@\\S+)?\\s+((pages|versions)\\s+)?(deploy|publish)\\b(?![^;&|\\n]*\\s--dry-run(\\s|$))|\\bvercel\\b[^;&|\\n]*\\s--prod\\b|\\b(npm|pnpm|yarn|bun)\\s+((-{1,2}\\w[\\w-]*(=\\S+|\\s+[^-\\s]\\S*)?|run|exec|workspace\\s+\\S+)\\s+)*(deploy|yayinla|publish)\\b(?![^;&|\\n]*\\s--dry-run(\\s|$))"
      },
      {
        "ad": "uzak veritabanına yazma",
        "desen": "\\bwrangler(@\\S+)?\\s+d1\\s+(execute|migrations\\s+apply)\\b[^;&|\\n]*--remote\\b"
      },
      {
        "ad": "canlı ortam ayarı (secret, rollback)",
        "desen": "\\bwrangler(@\\S+)?\\s+(secret\\s+(put|delete|bulk)|rollback)\\b|\\b(flyctl|fly)\\s+secrets\\s+(set|unset|import)\\b|\\bvercel\\s+env\\s+(add|rm)\\b"
      }
    ]
  },
  "ders": {
    "hatirlatMesaj": 25
  },
  "kapaliKancalar": []
}
